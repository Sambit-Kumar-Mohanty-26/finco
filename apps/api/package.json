{
  "name": "@finco/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "start:worker": "tsx src/worker.ts",
    "cron:recon-pull": "tsx src/cron.ts",
    "typecheck": "tsc --noEmit",
    "check": "node --experimental-strip-types src/db/bigint.check.mts && node --experimental-strip-types src/env.check.mts && node --experimental-strip-types src/recon/recon.check.mts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@finco/core": "workspace:*",
    "@neondatabase/serverless": "^0.10.4",
    "cors": "^2.8.5",
    "drizzle-orm": "^0.38.3",
    "express": "^5.0.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "tsx": "^4.19.2"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.7",
    "drizzle-kit": "^0.30.1",
    "pino-pretty": "^13.1.3",
    "typescript": "^5.7.3"
  }
}
