# The Neon connection string, copied as-is from the Neon dashboard.
# Use the pooled one if Neon offers a choice — the direct connection needed by
# migrations and pg-boss is derived from it (see src/env.ts).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-south-1.aws.neon.tech/finco?sslmode=require"

# Comma-separated. Vercel preview hostnames are matched by regex separately.
ALLOWED_ORIGINS="http://localhost:3000"

PORT=4000

# Optional. T5 is the last tier and the only one that costs money — without a
# key the close still runs on the five deterministic tiers, which is how CI and
# local dev stay free. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSyMOCK-not-a-real-key-replace-me"
