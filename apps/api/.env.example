# The Neon connection string, copied as-is from the Neon dashboard.
# Use the pooled one if Neon offers a choice — the direct connection needed by
# migrations and pg-boss is derived from it (see src/env.ts).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.ap-south-1.aws.neon.tech/finco?sslmode=require"

# Comma-separated. Vercel preview hostnames are matched by regex separately.
ALLOWED_ORIGINS="http://localhost:3000"

PORT=4000

# Optional. T5 is the last tier and the only one that costs money — without a
# key the close still runs on the five deterministic tiers, which is how CI and
# local dev stay free. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY="AIzaSyMOCK-not-a-real-key-replace-me"

# Optional. Razorpay Dashboard → Settings → Webhooks → the secret you typed
# when creating the endpoint. Without it POST /webhooks/razorpay answers 503,
# and the nightly cron pull remains the source of truth.
RAZORPAY_WEBHOOK_SECRET="whsec_MOCK_replace_me"

# Optional. Razorpay Dashboard → Settings → API Keys. Read-only is enough:
# nothing here ever writes to Razorpay. Without them the nightly pull logs that
# it is not configured and exits 0 rather than failing the cron.
RAZORPAY_KEY_ID="rzp_test_MOCKMOCKMOCK"
RAZORPAY_KEY_SECRET="MOCKsecretMOCKsecret"

# Optional. Any incoming-webhook URL that accepts { text } — Slack, Discord or
# Teams. Alerts are logged either way; this only pushes them somewhere.
ALERT_WEBHOOK_URL="https://hooks.slack.com/services/MOCK/MOCK/MOCK"

# Optional. Sentry project DSN. Absent means the SDK never initialises and
# nothing leaves the machine, which is how CI and local dev stay offline.
SENTRY_DSN="https://mock@o0.ingest.sentry.io/0"

# Optional. Google sign-in. Without them the button is not drawn and the routes
# answer 503 — email and password still work, so a missing key removes one
# option rather than locking everybody out.
# Google Cloud console → APIs & Services → Credentials → OAuth client ID (Web).
GOOGLE_CLIENT_ID="000000000000-mockmockmockmockmock.apps.googleusercontent.com"
GOOGLE_CLIENT_SECRET="GOCSPX-MOCKmockMOCKmockMOCK"

# Where Google sends the browser back. Must match the redirect URI registered in
# that console EXACTLY, including the scheme and any trailing path. Configured
# rather than derived from the Host header, which the client controls.
PUBLIC_API_URL="http://localhost:4000"
